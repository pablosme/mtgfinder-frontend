{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "newProjectRoot": "projects",
    "projects": {
        "mtgfinder-frontend": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            },
                            {
                                "glob": "opencv.js",
                                "input": "node_modules/@techstark/opencv-js/dist",
                                "output": "assets/opencv"
                            },
                            {
                                "glob": "worker.min.js*",
                                "input": "node_modules/tesseract.js/dist",
                                "output": "assets/tesseract"
                            },
                            {
                                "glob": "*.wasm*",
                                "input": "node_modules/tesseract.js-core",
                                "output": "assets/tesseract/core"
                            },
                            {
                                "glob": "*/4.0.0_best_int/*.traineddata.gz",
                                "input": "node_modules/@tesseract.js-data",
                                "output": "assets/tesseract/languages"
                            }
                        ],
                        "styles": ["node_modules/mana-font/css/mana.css", "src/styles.scss"],
                        "server": "src/main.server.ts",
                        "outputMode": "server",
                        "security": {
                            "allowedHosts": []
                        },
                        "ssr": {
                            "entry": "src/server.ts"
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "local": {
                            "fileReplacements": [
                                {
                                    "replace": "src/app/core/environment/environment.ts",
                                    "with": "src/app/core/environment/environment-local.ts"
                                }
                            ],
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "online": {
                            "fileReplacements": [
                                {
                                    "replace": "src/app/core/environment/environment.ts",
                                    "with": "src/app/core/environment/environment-online.ts"
                                }
                            ],
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "local"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "local": {
                            "buildTarget": "mtgfinder-frontend:build:local",
                            "allowedHosts": ["*"]
                        },
                        "online": {
                            "buildTarget": "mtgfinder-frontend:build:online",
                            "allowedHosts": ["*"]
                        },
                        "production": {
                            "buildTarget": "mtgfinder-frontend:build:production"
                        },
                        "development": {
                            "buildTarget": "mtgfinder-frontend:build:development"
                        }
                    },
                    "defaultConfiguration": "local"
                },
                "test": {
                    "builder": "@angular/build:unit-test"
                }
            }
        }
    }
}
